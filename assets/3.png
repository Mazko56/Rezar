</div>

<script>

    function validateCostForm(){
        var name = $('.precalculate-form input[name="mpcost-name"]');
        var phone = $('.precalculate-form input[name="mpcost-phone"]');
        var autobrand = $('.precalculate-form input[name="auto-brand"]');
        var automodel = $('.precalculate-form input[name="auto-model"]');

        var fields = [name,phone,autobrand,automodel];
        var valid = true;

        for (var i in fields){
            if ($(fields[i]).val() == ''){
                $(fields[i]).addClass('error');
                valid = false;
            }
        }
        if (!valid){
            changeStep(1);
            $().toastmessage('showErrorToast', "Заполните пожалуйста все необходимые поля");
        }

        return valid;
    }

    function costNextStep(){
        var stepId = $('.precalculate-form .step.active').data('stepid');
        if (stepId < 2){
            changeStep(stepId+1);
        }else{
            if (validateCostForm()){

                var fielddata = {
                    'form-name': 'Узнайте предварительную стоимость своего авто'
                    //'call-name': $('.precalculate-form input[name="mpcost-name"]').val(),
                    //'call-phone': $('.precalculate-form input[name="mpcost-phone"]').val()
                };

                $('.precalculate-form input[type="text"]').map(function(i,el){
                    fielddata[$(el).attr('name')] = $(el).val();
                });

                $('.precalculate-form select').map(function(i,el){
                    fielddata[$(el).attr('name')] = $(el).val();
                });

                $('.precalculate-form input[type="checkbox"]:checked').map(function(i,el){
                    fielddata[$(el).attr('name')] = $(el).val();
                });
                $.post('/',
                    fielddata,
                    function(res){
                        location.href = '/thankyou.php';
                    }
                );
            }
        }
    }

    function changeStep(stepId){
        $('.precalculate-form .step').removeClass('active');
        $('.precalculate-form .slide').removeClass('active');

        $('.precalculate-form .step-' + stepId).addClass('active');
        $('#costform-slide-' + stepId).addClass('active');

        $('.precalculate-form .step').removeClass('selected');
        if (stepId >= 1){$('.precalculate-form .step-1').addClass('selected');}
        if (stepId >= 2){$('.precalculate-form .step-2').addClass('selected');}
        if (stepId >= 3){$('.precalculate-form .step-3').addClass('selected');}

        if (stepId == 2){
            $('.mp-cost-footer .yellow-button').html('ПОЛУЧИТЬ СТОИМОСТЬ');
        }else{
            $('.mp-cost-footer .yellow-button').html('СЛЕДУЮЩИЙ ШАГ');
        }
        smoothscrollTo('.precalculate-form');
    }

    $(function(){

        $('.precalculate-form .step').click(function(){

            var stepId = $(this).data('stepid');
            changeStep(stepId);

        });

        $('.mp-cost input').focus(function(){
            $(this).removeClass('error');
        });
    });

</script></div>

</div>
</div>

