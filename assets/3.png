    <div class="wrapper">
        <div class="try_auct">
            <div class="title">Покупайте автомобили из Кореи <span>с выгодой до 50% *</span></div>
            <div class="text">* в сравнении с покупкой авто на украинском рынке</div>
            <div class="button"><a onclick="openbox('#popup_form_window'); return false;" class="yellow-button" href="#">ПОДОБРАТЬ АВТО ИЗ КОРЕИ</a></div>
            <div class="picture"><img src="/templates/_default_/images/auctiion_picture.png" alt=""></div>
        </div>
